{
  "name": "vexoo",
  "private": true,
  "version": "0.1.0",
  "description": "Vexoo Clinic Operations Platform — Web + Mobile monorepo",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "web": "npm --workspace apps/web run dev",
    "mobile": "npm --workspace apps/mobile run start",
    "build:web": "npm --workspace apps/web run build"
  }
}
